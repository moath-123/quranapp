<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:paddingVertical="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtReadSuraName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="@dimen/_4sdp"
            android:text="@string/app_name"
            android:textColor="@color/quran_serial_no_color"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReadSuraPageNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="@dimen/_4sdp"
            android:textColor="@color/quran_serial_no_color"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReadSuraJuzName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="@dimen/_4sdp"
            android:text="Juz 1"
            android:textColor="@color/quran_serial_no_color"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

    </RelativeLayout>


    <TextView
        android:id="@+id/txtPageText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_weight="1"
        android:fontFamily="@font/kfgqpc_uthman_taha_naskh_regular"
        android:gravity="start"
        android:hyphenationFrequency="none"
        android:includeFontPadding="false"
        android:longClickable="true"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textAlignment="viewStart"
        android:textColor="@android:color/black"
        android:textDirection="rtl"
        android:textIsSelectable="true"
        android:textSize="20sp" />


</LinearLayout>



